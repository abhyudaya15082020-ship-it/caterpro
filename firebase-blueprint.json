{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, contact info and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "vendor", "admin"] },
        "city": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "VendorService": {
      "title": "VendorService",
      "description": "Catering team or staff service package",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string", "maxLength": 128 },
        "vendorId": { "type": "string", "maxLength": 128 },
        "vendorName": { "type": "string", "maxLength": 100 },
        "serviceType": { "type": "string", "enum": ["full_catering", "gents_staff", "ladies_staff", "combined_staff", "cooks_only", "cleaning"] },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "city": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "pricePerPlate": { "type": "number" },
        "pricePerStaffDay": { "type": "number" },
        "gentsStaffAvailable": { "type": "number" },
        "ladiesStaffAvailable": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 20 },
        "specialties": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["serviceId", "vendorId", "vendorName", "serviceType", "title"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Catering and staffing booking reservation",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "serviceTitle": { "type": "string", "maxLength": 150 },
        "eventType": { "type": "string", "maxLength": 50 },
        "eventDate": { "type": "string", "maxLength": 50 },
        "eventTime": { "type": "string", "maxLength": 50 },
        "eventLocation": { "type": "string", "maxLength": 200 },
        "guestCount": { "type": "number" },
        "gentsStaffCount": { "type": "number" },
        "ladiesStaffCount": { "type": "number" },
        "selectedMenu": { "type": "string", "maxLength": 2000 },
        "specialInstructions": { "type": "string", "maxLength": 1000 },
        "totalAmount": { "type": "number" },
        "advancePaid": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "advance_paid", "fully_paid"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["bookingId", "userId", "customerName", "customerPhone", "eventType", "eventDate", "guestCount", "totalAmount", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer rating and review for catering service",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string", "maxLength": 128 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "eventType": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["reviewId", "serviceId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/VendorService" },
      "description": "Catering and staff service packages"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer reservations and quotations"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Service ratings and reviews"
    }
  }
}
